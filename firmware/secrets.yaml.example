# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is gitignored to keep your credentials out of version control.

wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# ESPHome native API encryption key (32-byte base64).
# Generate with: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY="

# OTA update password — used to reflash firmware over network.
# Pick something strong; it's required for every OTA flash.
ota_password: "ReplaceWithStrongPassword"

# Fallback hotspot password — used when ESP can't connect to WiFi.
fallback_ap_password: "FallbackPassword"
